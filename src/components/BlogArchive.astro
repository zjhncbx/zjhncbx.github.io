---
/**
 * BlogArchive — the news list component (news = /blog/).
 *
 * Renders one page of posts, the "按年份筛选" (filter by year) sidebar, and
 * pagination. All data/URL maths lives in src/lib/blog.ts; this component is
 * purely presentational so the index route and the per-year / paginated routes
 * share identical markup.
 *
 * Props:
 *   posts       — posts for the current page
 *   years       — [{year, count}] newest-first, for the sidebar
 *   currentYear — active year filter (null = all years)
 *   page        — 1-based current page
 *   totalPages  — pages in this filter
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import livepages from '../data/livepages.json';
import ResponsiveImage from './ResponsiveImage.astro';
import { fmtDate, stripHtml } from '../lib/blog';

interface Props {
  posts: {
    id: string;
    title: string;
    date: string;
    categories: string[];
    thumb?: string;
    excerpt: string;
    content: string;
  }[];
  years: { year: string; count: number }[];
  currentYear?: string | null;
  page: number;
  totalPages: number;
}

const {
  posts,
  years,
  currentYear = null,
  page,
  totalPages,
} = Astro.props;

const shell = livepages.blog;
const base = 'https://www.hncbx.org.cn';

/** Canonical URL for the current page. */
function canonical(): string {
  const segment = currentYear
    ? `year/${currentYear}${page > 1 ? `/page/${page}` : ''}`
    : page > 1
      ? `page/${page}`
      : '';
  return `${base}/blog/${segment}`;
}

/** Relative link to a year-filtered or unfiltered archive page. */
function hrefFor(year: string | null, p: number): string {
  const baseHref = '/blog/';
  if (year) {
    return p > 1 ? `${baseHref}year/${year}/page/${p}/` : `${baseHref}year/${year}/`;
  }
  return p > 1 ? `${baseHref}page/${p}/` : baseHref;
}

const pageTitle = currentYear
  ? `${currentYear}年新闻通告 | 潮百相公益——兴趣公益与社会创新的领导者`
  : page > 1
    ? `新闻通告（第 ${page} 页） | 潮百相公益——兴趣公益与社会创新的领导者`
    : '新闻通告 | 潮百相公益——兴趣公益与社会创新的领导者';

const pageDescription = currentYear
  ? `潮百相公益${currentYear}年新闻通告与活动资讯`
  : '潮百相公益新闻通告与活动资讯';

// Windowed pagination numbers, e.g. [1, '…', 4, 5, 6, '…', 24]
function pageItems(current: number, total: number): (number | '…')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const items: (number | '…')[] = [1];
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  if (start > 2) items.push('…');
  for (let i = start; i <= end; i++) items.push(i);
  if (end < total - 1) items.push('…');
  items.push(total);
  return items;
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  seo={{ title: pageTitle, description: pageDescription, canonical: canonical() }}
>
  <Fragment set:html={shell.header} />
  <div id="content" class="page-wrap">
    <div class="content-wrapper container">
      <div class="row">
        <div id="primary" class="content-area sidebar-right layout1 col-md-9">
          <main id="main" class="post-wrap" role="main">
            <div class="posts-layout">
              <div class="row">
                {posts.map((p) => (
                  <article class="post col-md-12 post-align-left">
                    <div class="content-inner">
                      {p.thumb && (
                        <div class="post-thumbnail">
                          <a href={`/blog/${p.id}/`}>
                            <ResponsiveImage
                              src={p.thumb}
                              alt={p.title}
                              width={480}
                              height={300}
                              loading="lazy"
                              webpSrc={p.thumb.replace(/\.(jpe?g|png)$/i, '-480.webp')}
                            />
                          </a>
                        </div>
                      )}
                      <div class="entry-meta above-title delimiter-dot">
                        <span class="posted-on">
                          <time class="entry-date published updated" datetime={p.date}>{fmtDate(p.date)}</time>
                        </span>
                        {p.categories.length > 0 && (
                          <span class="cat-links">{p.categories.join(' / ')}</span>
                        )}
                      </div>
                      <header class="entry-header">
                        <h2 class="title-post entry-title">
                          <a href={`/blog/${p.id}/`}>{p.title}</a>
                        </h2>
                      </header>
                      <div class="entry-post">
                        <p>{stripHtml(p.excerpt || p.content).slice(0, 140)}</p>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>

            {
              totalPages > 1 && (
                <nav class="navigation pagination" aria-label="文章分页">
                  <h2 class="screen-reader-text">文章分页</h2>
                  <div class="nav-links">
                    {page > 1 ? (
                      <a class="prev page-numbers" href={hrefFor(currentYear, page - 1)}>&lt;</a>
                    ) : (
                      <span class="page-numbers dots">&lt;</span>
                    )}
                    {pageItems(page, totalPages).map((item) =>
                      typeof item === 'number' ? (
                        item === page ? (
                          <span aria-current="page" class="page-numbers current">{item}</span>
                        ) : (
                          <a class="page-numbers" href={hrefFor(currentYear, item)}>{item}</a>
                        )
                      ) : (
                        <span class="page-numbers dots">&hellip;</span>
                      ),
                    )}
                    {page < totalPages ? (
                      <a class="next page-numbers" href={hrefFor(currentYear, page + 1)}>&gt;</a>
                    ) : (
                      <span class="page-numbers dots">&gt;</span>
                    )}
                  </div>
                </nav>
              )
            }
          </main>
        </div>

        <div id="secondary" class="widget-area col-md-3" role="complementary">
          <aside class="widget widget_archive">
            <h3 class="widget-title">按年份筛选</h3>
            <ul>
              <li>
                <a href={hrefFor(null, 1)} class={!currentYear ? 'current' : undefined}>全部年份</a>
              </li>
              {years.map((y) => (
                <li>
                  <a
                    href={hrefFor(y.year, 1)}
                    class={currentYear === y.year ? 'current' : undefined}
                  >
                    {y.year} 年<span class="year-count">（{y.count} 篇）</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </div>
  </div>
  <Fragment set:html={shell.footer} />
</BaseLayout>

<style is:inline>
/* Year-filter sidebar: match the Sydney widget look, highlight the active year */
#secondary .widget_archive ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
#secondary .widget_archive li {
  padding: 6px 0;
  border-bottom: 1px solid #eee;
}
#secondary .widget_archive li a {
  color: #2b2b2b;
  text-decoration: none;
  display: block;
  font-size: 15px;
}
#secondary .widget_archive li a:hover,
#secondary .widget_archive li a.current {
  color: #0a7d63;
  font-weight: 600;
}
#secondary .widget_archive .year-count {
  color: #888;
  font-weight: 400;
  font-size: 13px;
}
</style>
