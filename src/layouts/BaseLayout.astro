---
import assetsData from '../data/assets.json';

const assets = assetsData;

interface Props {
  title?: string;
  description?: string;
  styles?: string[];
  bodyClass?: string;
}

const {
  title = '潮百相公益',
  description = '兴趣公益与社会创新的领导者',
  styles = [],
  bodyClass = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/wp-content/uploads/2020/10/加字圆形logo.jpg" />
    {assets.css.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {styles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <link rel="stylesheet" href="/assets/inline.css" />
    <style is:inline>
      /* Non-home pages: make the transparent Sydney header a solid bar so the nav is visible at the top */
      body:not(.is-home) .site-header {
        position: static !important;
        background-color: #263246 !important;
      }
      /* Remove the empty hero area left on non-front pages (avoids a stray white block) */
      body:not(.is-home) .sydney-hero-area {
        display: none;
      }
    </style>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
