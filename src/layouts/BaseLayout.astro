---
import assetsData from '../data/assets.json';
import SEO from '../components/seo/SEO.astro';

const assets = assetsData;

interface Props {
  title?: string;
  description?: string;
  styles?: string[];
  bodyClass?: string;
  /** CSS bundle scope (batch ④): 'blog' ships only the theme files the blog
   *  template actually needs (6 files ≈77KB) instead of the full 21 ≈400KB. */
  cssScope?: 'global' | 'blog';
  seo?: {
    title?: string;
    description?: string;
    canonical?: string;
    ogImage?: string;
    ogType?: string;
    article?: boolean;
    publishedTime?: string;
    modifiedTime?: string;
    organization?: boolean;
    website?: boolean;
  };
}

const {
  title = '潮百相公益——兴趣公益与社会创新的领导者',
  description = '海宁市潮百相公益发展协会官网',
  styles = [],
  bodyClass = '',
  cssScope = 'global',
  seo = {},
} = Astro.props;

const cssList = cssScope === 'blog' ? assets.blogCss : assets.css;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://hm.baidu.com" />
    <SEO
      title={seo.title ?? title}
      description={seo.description ?? description}
      canonical={seo.canonical}
      ogImage={seo.ogImage}
      ogType={seo.ogType}
      article={seo.article}
      publishedTime={seo.publishedTime}
      modifiedTime={seo.modifiedTime}
      organization={seo.organization}
      website={seo.website}
    />
    <link rel="icon" type="image/jpeg" href="/wp-content/uploads/2020/10/加字圆形logo.jpg" />
    {cssList.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {styles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <link rel="stylesheet" href="/assets/inline.css" />
    <!-- Baidu analytics (asynchronous) -->
    <script is:inline>
      var _hmt = _hmt || [];
      (function () {
        var hm = document.createElement('script');
        hm.src = 'https://hm.baidu.com/hm.js?ad77b7a994f4a8928d834a71d82b1568';
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
