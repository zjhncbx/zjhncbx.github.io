---
import assetsData from '../data/assets.json';
import SEO from '../components/seo/SEO.astro';

const assets = assetsData;

interface Props {
  title?: string;
  description?: string;
  styles?: string[];
  bodyClass?: string;
  seo?: {
    title?: string;
    description?: string;
    canonical?: string;
    ogImage?: string;
    ogType?: string;
    article?: boolean;
    publishedTime?: string;
    modifiedTime?: string;
    organization?: boolean;
    website?: boolean;
  };
}

const {
  title = '潮百相公益——兴趣公益与社会创新的领导者',
  description = '海宁市潮百相公益发展协会官网',
  styles = [],
  bodyClass = '',
  seo = {},
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={seo.title ?? title}
      description={seo.description ?? description}
      canonical={seo.canonical}
      ogImage={seo.ogImage}
      ogType={seo.ogType}
      article={seo.article}
      publishedTime={seo.publishedTime}
      modifiedTime={seo.modifiedTime}
      organization={seo.organization}
      website={seo.website}
    />
    <link rel="icon" type="image/jpeg" href="/wp-content/uploads/2020/10/加字圆形logo.jpg" />
    {assets.css.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {styles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <link rel="stylesheet" href="/assets/inline.css" />
    <style is:inline>
      /* Non-home pages: the navbar must sit at the very top (no white bar above it) and be solid */
      body:not(.is-home) .site-header {
        position: static !important;
        top: 0 !important;
        background-color: #263246 !important;
      }
      body:not(.is-home) .header-clone,
      body:not(.is-home) .sydney-hero-area,
      body:not(.is-home) .header-image {
        display: none;
      }

      /* Adapt the main content to very wide screens so it fills more of the viewport */
      @media (min-width: 1400px) {
        .container {
          width: 100% !important;
          max-width: 1400px !important;
        }
        .elementor-section.elementor-section-boxed > .elementor-container {
          max-width: 1400px !important;
        }
      }
      @media (min-width: 1700px) {
        .container {
          width: 100% !important;
          max-width: 1600px !important;
        }
        .elementor-section.elementor-section-boxed > .elementor-container {
          max-width: 1600px !important;
        }
      }

      /* Footer: keep content centered & full-width, no left-shift on wide screens.
         The migrated footer uses a Bootstrap .row/.col-md-6 split with an empty
         second column and a nested .site-info.container; we neutralize those so the
         credits span the whole (centered) container and stay centered at 375–2560px. */
      .site-footer,
      #colophon {
        width: 100%;
      }
      .site-footer > .container,
      #colophon > .container {
        width: 100% !important;
        margin-inline: auto !important;
      }
      .site-footer .site-info,
      #colophon .site-info {
        width: 100%;
        text-align: center;
      }
      .site-footer .sydney-credits,
      #colophon .sydney-credits {
        text-align: center;
        width: 100%;
      }
      /* neutralize the empty right column + nested container from the migrated markup */
      .site-footer .row,
      #colophon .row {
        width: 100%;
        margin: 0;
      }
      .site-footer .col-md-6,
      #colophon .col-md-6 {
        width: 100% !important;
        float: none !important;
        padding: 0 !important;
        flex: 0 0 100% !important;
        max-width: 100% !important;
      }
      .site-footer .site-info.container,
      #colophon .site-info.container {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .site-footer .site-info.container + *,
      #colophon .site-info.container + * {
        clear: both;
      }

      /* Mobile: keep the hero a reasonable height and reduce oversized type */
      @media (max-width: 767px) {
        .sydney-hero-area,
        #slideshow.header-slider,
        #slideshow .slides-container,
        #slideshow .slides-container .slide-item {
          height: 60vh !important;
          min-height: 380px;
        }
        #slideshow .text-slider .maintitle {
          font-size: 26px !important;
          line-height: 1.25 !important;
        }
        #slideshow .text-slider .subtitle {
          font-size: 15px !important;
          line-height: 1.4 !important;
          padding: 10px 0 24px !important;
        }
        #slideshow .slide-inner .contain {
          padding: 0 16px;
        }
      }

      /* WeChat migrated media cards (video / audio / Tencent frame) */
      .wechat-video-card,
      .wechat-audio-card {
        margin: 18px auto;
        max-width: 100%;
        box-sizing: border-box;
      }
      .wechat-video-card__link,
      .wechat-audio-card__link {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: #333;
        background: #f6f7f9;
        border: 1px solid #e6e8ee;
        border-radius: 12px;
        padding: 12px;
        box-sizing: border-box;
        max-width: 100%;
      }
      .wechat-video-card__cover,
      .wechat-audio-card__cover {
        position: relative;
        flex: 0 0 120px;
        width: 120px;
        height: 80px;
        border-radius: 8px;
        overflow: hidden;
      }
      .wechat-video-card__cover img,
      .wechat-audio-card__cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .wechat-video-card__play {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        background: rgba(0, 0, 0, 0.25);
      }
      .wechat-video-card__meta,
      .wechat-audio-card__meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
      }
      .wechat-video-card__meta strong,
      .wechat-audio-card__meta strong {
        font-size: 15px;
        line-height: 1.35;
        color: #222;
      }
      .wechat-video-card__acct,
      .wechat-audio-card__meta span {
        font-size: 12px;
        color: #7a7a7a;
      }
      .wechat-video-card__cta,
      .wechat-audio-card__cta {
        font-size: 13px;
        color: #0a7d63;
        font-weight: 600;
      }
      /* Tencent video iframe -> responsive 16:9 */
      .wechat-video-frame {
        position: relative;
        width: 100%;
        margin: 18px auto;
        aspect-ratio: 16 / 9;
        background: #000;
        border-radius: 12px;
        overflow: hidden;
      }
      .wechat-video-frame iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .wechat-video-frame video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: #000;
      }
      @media (max-width: 480px) {
        .wechat-video-card__cover,
        .wechat-audio-card__cover {
          flex-basis: 92px;
          width: 92px;
          height: 64px;
        }
      }
    </style>
    <!-- Baidu analytics (asynchronous) -->
    <script is:inline>
      var _hmt = _hmt || [];
      (function () {
        var hm = document.createElement('script');
        hm.src = 'https://hm.baidu.com/hm.js?ad77b7a994f4a8928d834a71d82b1568';
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
