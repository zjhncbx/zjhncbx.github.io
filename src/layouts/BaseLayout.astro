---
import assetsData from '../data/assets.json';

const assets = assetsData;

interface Props {
  title?: string;
  description?: string;
  styles?: string[];
}

const {
  title = '潮百相公益',
  description = '兴趣公益与社会创新的领导者',
  styles = [],
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/wp-content/uploads/2020/10/加字圆形logo.jpg" />
    {assets.css.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {styles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <link rel="stylesheet" href="/assets/inline.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
