---
import BaseLayout from '../layouts/BaseLayout.astro';
import assetsData from '../data/assets.json';
import livepages from '../data/livepages.json';

const page = livepages.services;
const globalCss = new Set(assetsData.css);
const extraCss = page.css.filter((c) => !globalCss.has(c));
import { SITE } from '../consts';
const base = SITE;
---

<BaseLayout
  title="服务项目 | 潮百相公益——兴趣公益与社会创新的领导者"
  description="海宁市潮百相公益发展协会服务项目：志愿服务、青年团建、语言文化保护、公共交通与公益宣传等。"
  styles={extraCss}
  seo={{
    title: '服务项目 | 潮百相公益——兴趣公益与社会创新的领导者',
    description: '海宁市潮百相公益发展协会服务项目：志愿服务、青年团建、语言文化保护、公共交通与公益宣传等。',
    canonical: `${base}/services/`,
  }}
>
  <Fragment set:html={page.body} />
</BaseLayout>
