---
import BaseLayout from '../layouts/BaseLayout.astro';
import blocks from '../data/render_blocks.json';
import postsData from '../data/posts.json';

const footer = blocks.home_footer.replace(/<\/body>\s*<\/html>\s*$/i, '');

// Latest 10 published articles by publish date (replaces the static recent-posts widget)
const latest = postsData
  .filter((p) => p.status === 'publish' && p.title)
  .sort((a, b) => (a.date > b.date ? -1 : a.date < b.date ? 1 : 0))
  .slice(0, 10);

const esc = (s) =>
  String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const recentItems = latest
  .map((p) => `\n\t\t\t\t\t<li>\n\t\t\t\t\t\t<a href="/blog/${p.id}/">${esc(p.title)}</a>\n\t\t\t\t\t</li>`)
  .join('\n');

let content = blocks.home_content;
const recentRe = /(<h5>近期资讯<\/h5>[^\n]*\s*<ul>)[\s\S]*?(<\/ul>)/;
if (recentRe.test(content)) {
  content = content.replace(recentRe, (_m, pre, post) => pre + recentItems + post);
}
---

<BaseLayout bodyClass="is-home">
  <Fragment set:html={blocks.home_header} />
  <Fragment set:html={blocks.home_hero} />
  <Fragment set:html={content} />
  <Fragment set:html={footer} />
</BaseLayout>

<style is:inline>
/* Make the Sydney hero slider render full-height even without the JS slider plugin */
.sydney-hero-area,
#slideshow.header-slider {
  height: 100vh !important;
  min-height: 480px;
}
#slideshow.header-slider .slides-container,
#slideshow.header-slider .slides-container .slide-item {
  height: 100vh !important;
  min-height: 480px;
}
#slideshow .slide-item {
  background-position: center center !important;
  background-size: cover !important;
}
#slideshow img.mobile-slide {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}
#slideshow .slide-inner {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  text-align: center;
  z-index: 2;
  width: 100%;
}

/* Stats dark box: stop the first icon from overflowing the box on the left */
.elementor-section[data-id="bb883c1"] .elementor-container {
  padding-left: 20px;
  padding-right: 20px;
}
.elementor-section[data-id="bb883c1"] .elementor-icon-box-wrapper {
  min-width: 0;
}

/* 了解更多 QR row: stack vertically on mobile */
@media (max-width: 767px) {
  .elementor-element-qrgrid .elementor-column {
    width: 100% !important;
  }
}

/* Tighten the vertical spacing of the main content, hero and footer wrappers */
#content {
  padding-top: 30px !important;
  padding-bottom: 30px !important;
}
.sydney-hero-area {
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}
.sidebar-footer,
.footer-widgets {
  padding-top: 20px !important;
  padding-bottom: 20px !important;
}
</style>
