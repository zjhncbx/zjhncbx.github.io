---
// /blog/ — news list, page 1 of all years (see src/components/BlogArchive.astro).
import BlogArchive from '../../components/BlogArchive.astro';
import { publishedPosts, yearCounts, paginate, pageCount } from '../../lib/blog';

const all = publishedPosts();
const posts = paginate(all, 1);
const years = yearCounts(all);
---

<BlogArchive posts={posts} years={years} currentYear={null} page={1} totalPages={pageCount(all.length)} />
