---
import BaseLayout from '../../layouts/BaseLayout.astro';
import livepages from '../../data/livepages.json';
import postsMeta from '../../data/posts.meta.json';
import { fmtDate, isoDate, loadPostBody } from '../../lib/blog';
import { imagePipeline, webpTwinUrl, imageSize } from '../../lib/image';
import { SITE } from '../../consts';

export function getStaticPaths() {
  return postsMeta.map((p) => ({ params: { id: String(p.id) } }));
}

const shell = livepages.blog;
const post = postsMeta.find((p) => String(p.id) === Astro.params.id);
// batch ②: the body is the only 12MB-store element an article page needs; it is
// lazy-imported per id so no route ever parses posts it does not render.
const content = post ? await loadPostBody(String(post.id)) : '';

// first image url in content for og:image (prefer the post thumbnail when present)
const firstImage = post && (post.thumb || (/src="([^"]+)"/.exec(content) || [])[1]);
// batch ④: the header thumbnail serves the full-size .webp twin when one exists
// (Option C, like body images) with intrinsic dims from the sidecar to stop CLS;
// og:image keeps the classic URL for social crawlers.
const thumbUrl = post?.thumb ? webpTwinUrl(post.thumb) : '';
const thumbDims = thumbUrl ? imageSize(thumbUrl) : undefined;
const base = SITE;
const canonical = post ? `${base}/blog/${post.id}/` : base;
const ogImage = firstImage ? (firstImage.startsWith('http') ? firstImage : base + firstImage) : undefined;
---

<BaseLayout
  title={`${post?.title ?? '文章'} | 潮百相公益——兴趣公益与社会创新的领导者`}
  description={post?.desc ?? ''}
  cssScope="blog"
  seo={{
    title: `${post?.title ?? '文章'} | 潮百相公益——兴趣公益与社会创新的领导者`,
    description: post?.desc ?? '',
    canonical,
    ogImage,
    ogType: 'article',
    article: true,
    publishedTime: isoDate(post?.date),
    modifiedTime: isoDate(post?.modified ?? post?.date),
  }}
>
  <Fragment set:html={shell.header} />
  <div id="content" class="page-wrap">
    <div class="content-wrapper container">
      <div class="row">
        <div id="primary" class="content-area col-md-12">
          <main id="main" class="post-wrap" role="main">
            <article id={`post-${post?.id}`} class="post type-post status-publish post-align-left">
              <div class="content-inner">
                {thumbUrl && (
                  <div class="post-thumbnail">
                    <img src={thumbUrl} alt={post!.title} width={thumbDims?.[0]} height={thumbDims?.[1]} />
                  </div>
                )}
                <div class="entry-meta above-title delimiter-dot">
                  <span class="posted-on">
                    <time class="entry-date published updated" datetime={post?.date}>{fmtDate(post?.date)}</time>
                  </span>
                  {post && post.categories.length > 0 && (
                    <span class="cat-links">{post.categories.join(' / ')}</span>
                  )}
                </div>
                <header class="entry-header">
                  <h1 class="title-post entry-title">{post?.title}</h1>
                </header>
                <div class="entry-content">
                  {post && <Fragment set:html={imagePipeline(content)} />}
                </div>
              </div>
            </article>
          </main>
        </div>
      </div>
    </div>
  </div>
  <Fragment set:html={shell.footer} />
</BaseLayout>
