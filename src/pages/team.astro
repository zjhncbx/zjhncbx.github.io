---
import BaseLayout from '../layouts/BaseLayout.astro';
import assetsData from '../data/assets.json';
import livepages from '../data/livepages.json';

const page = livepages.team;
const globalCss = new Set(assetsData.css);
const extraCss = page.css.filter((c) => !globalCss.has(c));
const base = 'https://www.hncbx.org.cn';
---

<BaseLayout
  title="团队介绍 | 潮百相公益——兴趣公益与社会创新的领导者"
  description="海宁市潮百相公益发展协会团队介绍：青宁志愿者联合团、潮人语语言资源团、紫微城记、安澜交通等公益团队。"
  styles={extraCss}
  seo={{
    title: '团队介绍 | 潮百相公益——兴趣公益与社会创新的领导者',
    description: '海宁市潮百相公益发展协会团队介绍：青宁志愿者联合团、潮人语语言资源团、紫微城记、安澜交通等公益团队。',
    canonical: `${base}/team/`,
  }}
>
  <Fragment set:html={page.body} />
</BaseLayout>
